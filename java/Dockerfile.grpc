FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY java/ /build/
COPY proto/ /proto/
RUN --mount=type=cache,target=/root/.m2 mvn -B -q -pl grpc -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /build/grpc/target/app.jar app.jar
ENTRYPOINT ["java", "-jar", "/app/app.jar"]